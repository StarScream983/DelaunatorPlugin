#include "/Engine/Private/Common.ush"
#include "/Engine/Private/DeferredShadingCommon.ush"
#include "/Engine/Private/LargeWorldCoordinates.ush"
#include "MeshWeaverCommon.ush"

StructuredBuffer<QuadRenderInstance> InstanceBuffer;
StructuredBuffer<FVector3_HighLow> VoronoiGeoCenters;
StructuredBuffer<FVector3_HighLow> CBT_FibonacciPoints;
Buffer<uint> VoronoiCellColors;
Buffer<float> ElevationPerSite;
Buffer<float> DistanceToBoundaryNormPerSite;
Buffer<float> ErosionControlPerSite;
Buffer<uint> LandDistanceField;

float PlanetRadiusHigh;
float PlanetRadiusLow;
float4x4 LocalToWorld;
float3 WorldOriginHigh;
float3 WorldOriginLow;
uint Unlit;
uint ColorViewMode;
float MaxLandDistance;

// Same logic as GeoVoronoiPickDebugVertexColor in GeoVoronoiIndirectInstancing.ush.
float4 HashUIntToColor(uint x)
{
	x ^= x >> 16u;
	x *= 0x7feb352du;
	x ^= x >> 15u;
	x *= 0x846ca68bu;
	x ^= x >> 16u;
	uint rh = x * 0x9E3779B9u; rh ^= rh >> 16u;
	uint gh = x * 0x85EBCA6Bu; gh ^= gh >> 16u;
	uint bh = x * 0xC2B2AE35u; bh ^= bh >> 16u;
	return float4(float(rh & 255u) / 255.0f, float(gh & 255u) / 255.0f, float(bh & 255u) / 255.0f, 1.0f);
}

float3 GeoVoronoiSrgbUnitToLinear(float3 Srgb)
{
	const float3 Lo = Srgb / 12.92f;
	const float3 Hi = pow((Srgb + 0.055f) / 1.055f, 2.4f);
	return lerp(Lo, Hi, step(0.04045f, Srgb));
}

float4 GeoVoronoiRedBlob1843ColormapPackLinear(float3 RgbByte0To255)
{
	return float4(GeoVoronoiSrgbUnitToLinear(RgbByte0To255 / 255.0f), 1.0f);
}

float4 GeoVoronoiRedBlob1843Colormap(float Elev, float Moisture)
{
	static const float Width = 64.0f;
	const float e = clamp(Elev, -1.0f, 1.0f);
	float m = saturate(Moisture);
	int xi = (int)round((e + 1.0f) * 0.5f * Width);
	xi = clamp(xi, 0, (int)Width - 1);
	const int HalfW = (int)(Width * 0.5f);
	if (xi == HalfW - 1) return GeoVoronoiRedBlob1843ColormapPackLinear(float3(48.0f, 120.0f, 160.0f));
	if (xi == HalfW - 2) return GeoVoronoiRedBlob1843ColormapPackLinear(float3(48.0f, 100.0f, 150.0f));
	if (xi == HalfW - 3) return GeoVoronoiRedBlob1843ColormapPackLinear(float3(48.0f, 80.0f, 140.0f));
	if (e < 0.0f)
	{
		return GeoVoronoiRedBlob1843ColormapPackLinear(float3(48.0f + 48.0f * e, 64.0f + 64.0f * e, 127.0f + 127.0f * e));
	}
	float eland = e;
	m *= (1.0f - eland);
	float r = 210.0f - 100.0f * m;
	float g = 185.0f - 45.0f * m;
	float b = 139.0f - 45.0f * m;
	r = 255.0f * eland + r * (1.0f - eland);
	g = 255.0f * eland + g * (1.0f - eland);
	b = 255.0f * eland + b * (1.0f - eland);
	return GeoVoronoiRedBlob1843ColormapPackLinear(float3(r, g, b));
}

float4 GeoVoronoiPickDebugVertexColor(uint Mode, uint SiteId, float Elev, uint PackedCellColor, float DistNorm, float ErosionControl, uint LandDistHops, float MaxLandDist)
{
	if (Mode == 0u) return UnpackRGBA8(PackedCellColor);
	if (Mode == 1u)
	{
		float t = saturate(Elev * 0.5f + 0.5f);
		float3 rgb = (t < 0.5f)
			? lerp(float3(0.05f, 0.15f, 0.65f), float3(0.15f, 0.85f, 0.35f), t * 2.0f)
			: lerp(float3(0.15f, 0.85f, 0.35f), float3(0.90f, 0.20f, 0.10f), (t - 0.5f) * 2.0f);
		return float4(rgb, 1.0f);
	}
	if (Mode == 2u) return HashUIntToColor(SiteId);
	if (Mode == 3u)
	{
		float eCl = clamp(Elev, -1.0f, 1.0f);
		float moisture = saturate(0.72f - 0.55f * DistNorm);
		return GeoVoronoiRedBlob1843Colormap(eCl, moisture);
	}
	if (Mode == 4u)
	{
		float t = saturate(DistNorm);
		return float4(lerp(float3(0.15f, 0.55f, 0.95f), float3(0.95f, 0.25f, 0.12f), t), 1.0f);
	}
	if (Mode == 5u)
	{
		float t = saturate(ErosionControl);
		return float4(lerp(float3(0.95f, 0.25f, 0.12f), float3(0.15f, 0.55f, 0.95f), t), 1.0f);
	}
	if (Mode == 6u)
	{
		if (Elev < 0.0f) return float4(0.05f, 0.12f, 0.82f, 1.0f);
		const float MaxLand = max(MaxLandDist, 1.0f);
		float t = saturate(float(LandDistHops) / MaxLand);
		t = floor(t * 16.0f) / 16.0f;
		return float4(lerp(float3(0.0f, 0.88f, 0.95f), float3(0.98f, 0.52f, 0.08f), t), 1.0f);
	}
	return HashUIntToColor(SiteId);
}

struct FVSIn
{
	uint VertexId : SV_VertexID;
	uint InstanceId : SV_InstanceID;
};

struct FVSOut
{
	float4 ClipPos : SV_Position;
	float3 WorldNrm : TEXCOORD0;
	float3 BaseColor : TEXCOORD1;
};

struct FVector3_DF64
{
	float3 High;
	float3 Low;
};

void TwoProduct(float A, float B, out float Hi, out float Lo)
{
	Hi = A * B;
	// This shader's fma is the double intrinsic. The float product's error fits in that mantissa.
	Lo = (float)fma((double)A, (double)B, -(double)Hi);
}

void FastTwoSum(float A, float B, out float Hi, out float Lo)
{
	Hi = A + B;
	Lo = B - (Hi - A);
}

// Unit direction times radius, keeping the low half. A float multiply drops it.
FVector3_DF64 ScaleDF64(FVector3_DF64 V, float Scale)
{
	FVector3_DF64 Result;
	[unroll]
	for (int Axis = 0; Axis < 3; ++Axis)
	{
		float ProductHigh;
		float ProductLow;
		TwoProduct(V.High[Axis], Scale, ProductHigh, ProductLow);
		ProductLow += V.Low[Axis] * Scale;
		FastTwoSum(ProductHigh, ProductLow, Result.High[Axis], Result.Low[Axis]);
	}
	return Result;
}

FVector3_DF64 ReconstructPositionDF64(FVector3_HighLow V)
{
	FVector3_DF64 Result;
	Result.High = float3(V.X.High, V.Y.High, V.Z.High);
	Result.Low = float3(V.X.Low, V.Y.Low, V.Z.Low);
	return Result;
}

// High becomes the LWC tile. Low stays in the offset, which is what survives the camera shift.
FLWCVector3 MakeLWCVectorFromDF64(float3 High, float3 Low)
{
	const float TileSize = UE_LWC_RENDER_TILE_SIZE;
	const float InvTileSize = UE_LWC_RENDER_TILE_SIZE_RCP;
	float3 Tile = floor(High * InvTileSize);
	float3 Offset = (High - Tile * TileSize) + Low;
	return MakeLWCVector3(Tile, Offset);
}

FVector3_DF64 RotateDF64(FVector3_DF64 V, float3x3 Rotation)
{
	float3 RotatedHigh = mul(V.High, Rotation);
	float3 RotatedLow = mul(V.Low, Rotation);
	FVector3_DF64 Result;
	FastTwoSum(RotatedHigh.x, RotatedLow.x, Result.High.x, Result.Low.x);
	FastTwoSum(RotatedHigh.y, RotatedLow.y, Result.High.y, Result.Low.y);
	FastTwoSum(RotatedHigh.z, RotatedLow.z, Result.High.z, Result.Low.z);
	return Result;
}

FVSOut MainVS(FVSIn In)
{
	QuadRenderInstance Inst = InstanceBuffer[In.InstanceId];
	FVector3_DF64 V0 = ReconstructPositionDF64(VoronoiGeoCenters[Inst.GeoCenterA]);
	FVector3_DF64 V1 = ReconstructPositionDF64(VoronoiGeoCenters[Inst.GeoCenterB]);
	FVector3_DF64 V2 = ReconstructPositionDF64(CBT_FibonacciPoints[Inst.SiteId]);

	FVector3_DF64 VertexDF = V2;
	if (In.VertexId == 0)
	{
		VertexDF = V0;
	}
	else if (In.VertexId == 1)
	{
		VertexDF = V1;
	}

	float Elev = ElevationPerSite[Inst.SiteId];
	const float ElevationScale = 0.03f;
	const float RadiusScale = 1.0f + Elev * ElevationScale;
	FVector3_DF64 LocalDF = ScaleDF64(VertexDF, PlanetRadiusHigh * RadiusScale);
	float3 RadiusLowOffset = VertexDF.High * (PlanetRadiusLow * RadiusScale);
	float SumHigh;
	float SumLow;
	FastTwoSum(LocalDF.High.x, LocalDF.Low.x + RadiusLowOffset.x, SumHigh, SumLow);
	LocalDF.High.x = SumHigh;
	LocalDF.Low.x = SumLow;
	FastTwoSum(LocalDF.High.y, LocalDF.Low.y + RadiusLowOffset.y, SumHigh, SumLow);
	LocalDF.High.y = SumHigh;
	LocalDF.Low.y = SumLow;
	FastTwoSum(LocalDF.High.z, LocalDF.Low.z + RadiusLowOffset.z, SumHigh, SumLow);
	LocalDF.High.z = SumHigh;
	LocalDF.Low.z = SumLow;

	float3 V0f = V0.High + V0.Low;
	float3 V1f = V1.High + V1.Low;
	float3 V2f = V2.High + V2.Low;
	float3 VertexPos = (In.VertexId == 0) ? V0f : ((In.VertexId == 1) ? V1f : V2f);

	float3 LocalNrm = normalize(cross(V1f - V0f, V2f - V0f));
	if (dot(LocalNrm, VertexPos) < 0.0f)
	{
		LocalNrm = -LocalNrm;
	}

	FVector3_DF64 RotatedDF = RotateDF64(LocalDF, (float3x3)LocalToWorld);
	FLWCVector3 WorldLWC = LWCAdd(
		MakeLWCVectorFromDF64(RotatedDF.High, RotatedDF.Low),
		MakeLWCVectorFromDF64(WorldOriginHigh, WorldOriginLow));
	// Same pair InstancedStereo builds: tile is -ViewTilePosition, offset is RelativePreViewTranslation.
	FLWCVector3 PreViewTranslation = MakeLWCVector3(-View.ViewTilePosition, View.RelativePreViewTranslation);
	float3 TranslatedWorldPos = LWCToFloat(LWCAdd(WorldLWC, PreViewTranslation));

	float3 WorldNrm = normalize(mul(LocalNrm, (float3x3)LocalToWorld));

	FVSOut O;
	O.ClipPos = mul(float4(TranslatedWorldPos, 1.0f), View.TranslatedWorldToClip);
	O.WorldNrm = WorldNrm;
	O.BaseColor = GeoVoronoiPickDebugVertexColor(
		ColorViewMode,
		Inst.SiteId,
		Elev,
		VoronoiCellColors[Inst.SiteId],
		DistanceToBoundaryNormPerSite[Inst.SiteId],
		ErosionControlPerSite[Inst.SiteId],
		LandDistanceField[Inst.SiteId],
		MaxLandDistance).rgb;
	return O;
}

struct FPSOut
{
	float4 SceneColor : SV_Target0;
	float4 GBufferA : SV_Target1;
	float4 GBufferB : SV_Target2;
	float4 GBufferC : SV_Target3;
	float4 GBufferD : SV_Target4;
	float4 GBufferE : SV_Target5;
};

FPSOut MainPS(FVSOut In)
{
	FGBufferData GBuffer = (FGBufferData)0;
	GBuffer.WorldNormal = normalize(In.WorldNrm);
	GBuffer.BaseColor = In.BaseColor;
	GBuffer.Metallic = 0.0h;
	GBuffer.Specular = 0.5h;
	GBuffer.Roughness = 0.5h;
	GBuffer.GBufferAO = 1.0h;
	GBuffer.IndirectIrradiance = 0.0h;
	GBuffer.PrecomputedShadowFactors = 1.0h;
	GBuffer.ShadingModelID = Unlit != 0 ? SHADINGMODELID_UNLIT : SHADINGMODELID_DEFAULT_LIT;
	GBuffer.SelectiveOutputMask = 0;

	FPSOut O;
	O.SceneColor = Unlit != 0 ? float4(In.BaseColor, 1.0f) : 0;
	float4 UnusedVelocity;
	EncodeGBuffer(GBuffer, O.GBufferA, O.GBufferB, O.GBufferC, O.GBufferD, O.GBufferE, UnusedVelocity);
	return O;
}
